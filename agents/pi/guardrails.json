{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.0/schema.json",
  "applyBuiltinDefaults": true,
  "version": "0.16.2",
  "onboarding": {
    "completed": true,
    "completedAt": "2026-05-05T03:17:30.097Z",
    "version": "0.9.0-20260327"
  },
  "features": {
    "pathAccess": true
  },
  "pathAccess": {
    "mode": "ask",
    "allowedPaths": [
      {
        "kind": "file",
        "path": "/dev/null"
      },
      {
        "kind": "file",
        "path": "/dev/stdin"
      },
      {
        "kind": "file",
        "path": "/dev/stdout"
      },
      {
        "kind": "file",
        "path": "/dev/stderr"
      },
      {
        "kind": "file",
        "path": "/dev/tty"
      },
      {
        "kind": "file",
        "path": "/dev/zero"
      },
      {
        "kind": "file",
        "path": "/dev/random"
      },
      {
        "kind": "file",
        "path": "/dev/urandom"
      },
      {
        "kind": "directory",
        "path": "/tmp"
      },
      {
        "kind": "directory",
        "path": "/private/tmp"
      },
      {
        "kind": "directory",
        "path": "/var/folders"
      },
      {
        "kind": "directory",
        "path": "~/.agents"
      },
      {
        "kind": "directory",
        "path": "~/.bun/install/global/node_modules"
      },
      {
        "kind": "directory",
        "path": "~/.claude"
      },
      {
        "kind": "directory",
        "path": "~/.nvm/versions/node"
      },
      {
        "kind": "directory",
        "path": "~/.pi"
      }
    ]
  },
  "permissionGate": {
    "patterns": [
      {
        "pattern": "DROP DATABASE",
        "description": "SQL database drop"
      },
      {
        "pattern": "DROP TABLE",
        "description": "SQL table drop"
      },
      {
        "pattern": "aws ec2 terminate-instances",
        "description": "AWS EC2 instance termination"
      },
      {
        "pattern": "aws iam",
        "description": "AWS IAM permission changes"
      },
      {
        "pattern": "aws s3 rm",
        "description": "AWS S3 object deletion"
      },
      {
        "pattern": "brew",
        "description": "Homebrew package manager"
      },
      {
        "pattern": "docker compose down",
        "description": "Docker Compose service teardown"
      },
      {
        "pattern": "docker inspect",
        "description": "Docker inspect (may expose env vars)"
      },
      {
        "pattern": "docker rm",
        "description": "Docker container or image removal"
      },
      {
        "pattern": "docker system prune",
        "description": "Docker system cleanup"
      },
      {
        "pattern": "git push --force",
        "description": "Git force push"
      },
      {
        "pattern": "npm publish",
        "description": "NPM package publishing"
      },
      {
        "pattern": "pnpm publish",
        "description": "PNPM package publishing"
      },
      {
        "pattern": "sudo",
        "description": "Superuser command"
      },
      {
        "pattern": "terraform apply",
        "description": "Terraform infrastructure changes"
      },
      {
        "pattern": "terraform destroy",
        "description": "Terraform infrastructure destruction"
      },
      {
        "pattern": "terraform import",
        "description": "Terraform resource import"
      },
      {
        "pattern": "yarn publish",
        "description": "Yarn package publishing"
      }
    ]
  },
  "policies": {
    "rules": [
      {
        "id": "certificate-files",
        "name": "Private keys",
        "description": "Block private key files",
        "patterns": [
          {
            "pattern": "*.key"
          },
          {
            "pattern": "*.p12"
          },
          {
            "pattern": "*.pem"
          },
          {
            "pattern": "*.pfx"
          }
        ],
        "protection": "noAccess",
        "onlyIfExists": false
      },
      {
        "id": "database-files",
        "name": "Database files",
        "description": "Protect database files from modification",
        "patterns": [
          {
            "pattern": "*.db"
          },
          {
            "pattern": "*.sqlite"
          },
          {
            "pattern": "*.sqlite3"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": true
      },
      {
        "id": "home-aws",
        "name": "AWS directory",
        "description": "Block access to AWS credentials and configuration",
        "patterns": [
          {
            "pattern": "~/.aws/**"
          }
        ],
        "protection": "noAccess",
        "onlyIfExists": true
      },
      {
        "id": "home-ssh",
        "name": "SSH directory",
        "description": "Block access to SSH configuration and keys, except public keys",
        "patterns": [
          {
            "pattern": "~/.ssh/**"
          }
        ],
        "allowedPatterns": [
          {
            "pattern": "*.pub"
          }
        ],
        "protection": "noAccess",
        "onlyIfExists": false
      },
      {
        "id": "log-files",
        "name": "Log files",
        "description": "Treat log files as read-only",
        "patterns": [
          {
            "pattern": "*.log"
          },
          {
            "pattern": "*.out"
          }
        ],
        "protection": "readOnly",
        "onlyIfExists": true
      },
      {
        "id": "pi-agent-auth",
        "name": "Pi agent auth",
        "description": "Block access to Pi agent authentication data",
        "patterns": [
          {
            "pattern": "~/.pi/agent/auth.json"
          }
        ],
        "protection": "noAccess",
        "onlyIfExists": true
      },
      {
        "id": "secret-files",
        "name": "Secret files",
        "description": "Block dotenv files and variants",
        "patterns": [
          {
            "pattern": ".env"
          },
          {
            "pattern": ".env.*"
          },
          {
            "pattern": ".dev.vars"
          },
          {
            "pattern": ".npmrc"
          },
          {
            "pattern": ".pypirc"
          },
          {
            "pattern": ".netrc"
          }
        ],
        "allowedPatterns": [
          {
            "pattern": ".env.example"
          },
          {
            "pattern": ".env.sample"
          },
          {
            "pattern": ".env.test"
          },
          {
            "pattern": ".env.local"
          },
          {
            "pattern": "*.example.env"
          },
          {
            "pattern": "*.sample.env"
          },
          {
            "pattern": "*.test.env"
          }
        ],
        "protection": "noAccess",
        "onlyIfExists": false
      }
    ]
  }
}
